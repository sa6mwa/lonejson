cmake_minimum_required(VERSION 3.21)
find_program(ctest NAMES ctest REQUIRED)
execute_process(COMMAND "${ctest}" --test-dir "${BUILD_DIR}" --show-only=json-v1
  OUTPUT_VARIABLE inventory COMMAND_ERROR_IS_FATAL ANY)
string(JSON count LENGTH "${inventory}" tests)
if(count EQUAL 0)
  message(FATAL_ERROR "CTest inventory is empty")
endif()
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
  string(JSON name GET "${inventory}" tests ${index} name)
  string(JSON properties GET "${inventory}" tests ${index} properties)
  string(JSON property_count LENGTH "${properties}")
  set(has_timeout FALSE)
  set(has_labels FALSE)
  if(property_count GREATER 0)
    math(EXPR property_last "${property_count} - 1")
    foreach(property RANGE ${property_last})
      string(JSON key GET "${properties}" ${property} name)
      string(JSON value GET "${properties}" ${property} value)
      if(key STREQUAL "TIMEOUT" AND value GREATER 0)
        set(has_timeout TRUE)
      elseif(key STREQUAL "LABELS" AND NOT value STREQUAL "[]")
        set(has_labels TRUE)
      endif()
    endforeach()
  endif()
  if(NOT has_timeout OR NOT has_labels)
    message(FATAL_ERROR "${name}: positive TIMEOUT and nonempty LABELS required")
  endif()
endforeach()
