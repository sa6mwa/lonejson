cmake_minimum_required(VERSION 3.21)
file(READ "${INVENTORY}" inventory)
string(JSON count LENGTH "${inventory}" tests)
if(NOT count EQUAL 18)
  message(FATAL_ERROR "expected 16 fuzz cases and two prerequisite checks, got ${count}")
endif()
set(names "")
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
  string(JSON name GET "${inventory}" tests ${index} name)
  list(APPEND names "${name}")
  if(NOT name MATCHES "^lonejson_fuzz_(instrumentation|crash_handling)_tests$")
    string(JSON driver GET "${inventory}" tests ${index} command 0)
    string(JSON duration GET "${inventory}" tests ${index} command 2)
    if(NOT driver MATCHES "/scripts/fuzz[.]sh$" OR NOT duration STREQUAL "30")
      message(FATAL_ERROR "${name}: native AFL++ driver and declared duration required")
    endif()
    string(JSON arguments LENGTH "${inventory}" tests ${index} command)
    if(arguments LESS 6)
      message(FATAL_ERROR "${name}: missing declared seed corpus")
    endif()
    math(EXPR argument_last "${arguments} - 1")
    foreach(argument RANGE 5 ${argument_last})
      string(JSON seed GET "${inventory}" tests ${index} command ${argument})
      if(NOT IS_DIRECTORY "${seed}")
        message(FATAL_ERROR "${name}: missing seed directory ${seed}")
      endif()
    endforeach()
  endif()
endforeach()
foreach(case IN ITEMS base64 validate mapped_parse array_stream json_value
    value_visitor path_value_visitor value_rewrite reader_stream_generator
    writer_generator_backpressure writer_value_stream protocol_framing
    fixed_string_paths alloc_ceiling parser_boundaries jwt)
  if(NOT "lonejson_fuzz_${case}_tests" IN_LIST names)
    message(FATAL_ERROR "maintained fuzzer missing from CTest: ${case}")
  endif()
endforeach()
