cmake_minimum_required(VERSION 3.21)
foreach(field IN LISTS FIELDS)
  string(JSON type TYPE "${JSON}" "${field}")
  string(JSON value GET "${JSON}" "${field}")
  if(type STREQUAL "NULL")
    message(FATAL_ERROR "missing value for JSON field ${field}")
  elseif(type STREQUAL "BOOLEAN")
    if(value)
      set(value true)
    else()
      set(value false)
    endif()
  endif()
  if(DEFINED EXPECT_${field})
    if(EXPECT_${field} MATCHES "^(true|false)$" AND NOT type STREQUAL "BOOLEAN")
      message(FATAL_ERROR "JSON field ${field}: expected a boolean, got ${type}")
    endif()
    if(NOT value STREQUAL EXPECT_${field})
      message(FATAL_ERROR "JSON field ${field}: expected ${EXPECT_${field}}, got ${value}")
    endif()
  else()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${value}"
      COMMAND_ERROR_IS_FATAL ANY)
  endif()
endforeach()
