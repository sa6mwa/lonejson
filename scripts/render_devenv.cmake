cmake_minimum_required(VERSION 3.21)
file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/.." REPO_ROOT)
set(DEVENV_ROOT "${REPO_ROOT}/build/devenv")
execute_process(COMMAND "${REPO_ROOT}/scripts/require_build_workspace.sh" "${DEVENV_ROOT}"
  COMMAND_ERROR_IS_FATAL ANY)
string(SHA256 identity "${REPO_ROOT}")
string(SUBSTRING "${identity}" 0 12 identity)
set(POD_NAME "lonejson-e2e-${identity}")
set(ports "")
foreach(entry IN ITEMS "OAUTH2|OAUTH2|8090" "OIDC|OIDC|18443"
    "API|API_FIXTURE|18080" "NGINX_HTTP|NGINX_HTTP|8080"
    "NGINX_HTTPS|NGINX_HTTPS|8443")
  string(REPLACE "|" ";" entry "${entry}")
  list(GET entry 0 token)
  list(GET entry 1 name)
  list(GET entry 2 port)
  set(variable "LONEJSON_${name}_E2E_PORT")
  if(DEFINED ENV{${variable}})
    set(port "$ENV{${variable}}")
  endif()
  if(NOT port MATCHES "^[0-9]+$")
    message(FATAL_ERROR "${variable} must be a port between 1024 and 65535")
  endif()
  string(REGEX REPLACE "^0+" "" port "${port}")
  string(LENGTH "${port}" length)
  if(length GREATER 5 OR port STREQUAL "" OR port LESS 1024 OR port GREATER 65535)
    message(FATAL_ERROR "${variable} must be a port between 1024 and 65535")
  endif()
  if(port IN_LIST ports)
    message(FATAL_ERROR "published LONEJSON_*_E2E_PORT values must be distinct")
  endif()
  list(APPEND ports "${port}")
  set(${token}_PORT "${port}")
endforeach()
file(READ "${REPO_ROOT}/devenv.yaml.in" output)
foreach(token IN ITEMS REPO_ROOT DEVENV_ROOT POD_NAME OAUTH2_PORT OIDC_PORT
    API_PORT NGINX_HTTP_PORT NGINX_HTTPS_PORT)
  set(value "${${token}}")
  # Preserve UTF-8; escape YAML double-quoted scalar delimiters and controls.
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  string(REPLACE "@@${token}@@" "${value}" output "${output}")
endforeach()
if(output MATCHES "@@")
  message(FATAL_ERROR "unresolved devenv template placeholder")
endif()
if(NOT CHECK_ONLY)
  file(MAKE_DIRECTORY "${DEVENV_ROOT}")
  file(WRITE "${DEVENV_ROOT}/devenv.yaml.tmp" "${output}")
  file(CHMOD "${DEVENV_ROOT}/devenv.yaml.tmp" PERMISSIONS OWNER_READ OWNER_WRITE)
  file(RENAME "${DEVENV_ROOT}/devenv.yaml.tmp" "${DEVENV_ROOT}/devenv.yaml")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${POD_NAME}"
    COMMAND_ERROR_IS_FATAL ANY)
endif()
